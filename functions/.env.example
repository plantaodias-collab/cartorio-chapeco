# Nome de um bucket do Cloud Storage criado exclusivamente para os backups.
# Nao use o bucket publico do site nem reutilize um bucket com outros arquivos.
BACKUP_BUCKET=cartorio-chapeco-backups

# Quantidade de dias de copias a manter. O processo remove apenas arquivos
# dentro do prefixo cartorio-kanban/ deste bucket.
BACKUP_RETENTION_DAYS=30
